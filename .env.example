# ---------------------------------------------------------------
# University Department Classifier — environment configuration
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgresql://localhost:5432/udc_dev

# Separate database used by `npm test` (it is dropped and recreated)
TEST_DATABASE_URL=postgresql://localhost:5432/udc_test

# HTTP server
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:4000

# Cookies: set to true when serving over HTTPS
COOKIE_SECURE=false

# Classification engine
ML_SERVICE_URL=http://127.0.0.1:8001

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Public URL used in password-reset links
API_URL=http://localhost:4000
